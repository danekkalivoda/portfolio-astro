---
export interface Props {
  name: string;
  role?: string;
  company: string;
  quote: string;
  index: number;
}

const { name, role, company, quote, index } = Astro.props;
---

<article
    class="w-full transform-gpu ease-in-out duration-300 border-t border-gray-200 last:border-b"
    x-data={`{ testimonial${index}Shown: false }`}
    x-intersect:enter={`testimonial${index}Shown = true`}
    x-intersect:leave={`testimonial${index}Shown = false`}
    x-bind:class={`[testimonial${index}Shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-16']`}
>
    <div
        class=" p-4 sm:px-0"
    >
        <blockquote class="mb-4 text-gray-700 leading-relaxed text-base lg:text-lg">
            "{quote}"
        </blockquote>
        <div class="pt-4">
            <div class="font-semibold text-gray-900">{name}</div>
            {role && (
                <div class="text-sm text-gray-500">{role}</div>
            )}
            <div class="text-sm text-gray-600 font-medium mt-1">{company}</div>
        </div>
    </div>
</article>
