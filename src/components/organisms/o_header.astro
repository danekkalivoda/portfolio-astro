---
import MMenu from "../molecules/m_menu.astro";
import ALogo from "../atoms/a_logo.astro";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import type { Locale } from "../../i18n/types";
import { getTranslations } from "../../i18n/utils";

interface Props {
  homepage?: boolean;
  locale?: Locale;
}

const { homepage, locale = 'cs' } = Astro.props;
const t = getTranslations(locale);
---
<div class="header-container group" data-header-clip>
    <header
      class="header-base header--dark fixed top-0 left-0 right-0 z-100  backdrop-blur bg-gray-900/75" data-header-variant="dark"
    >
        <div class="md:max-w-4xl lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto w-full flex flex-row items-center h-16 pl-4 lg:h-22 sm:px-12 lg:px-16 xl:pl-5 xl:pr-0">
            <ALogo homepage={homepage}/>
            <MMenu navigation={t.navigation} />
            <LanguageSwitcher currentLocale={locale} className="ml-4" mode="desktop" />
        </div>
    </header>
</div>
