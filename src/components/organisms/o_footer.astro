---
const currentYear = new Date().getFullYear();
---
<footer class="relative py-12 mt-auto">
    <!-- Decorative separator -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 flex items-center gap-3 opacity-30">
        <span class="block w-12 h-px bg-gradient-to-r from-transparent to-gray-600"></span>
        <span class="block w-1.5 h-1.5 rounded-full bg-vestra"></span>
        <span class="block w-12 h-px bg-gradient-to-l from-transparent to-gray-600"></span>
    </div>

    <div class="max-w-4xl mx-auto px-6 text-center">
        <!-- Main credits row -->
        <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs text-gray-600">
            <span>&copy; {currentYear}</span>
            <span class="text-gray-700">/</span>
            <span>Vibe coded with</span>
            <a
                href="https://codepen.io/jh3y"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-500 hover:text-vestra transition-colors duration-300"
            >
                @jh3y
            </a>
        </div>

        <!-- Tech stack -->
        <div class="mt-3 flex items-center justify-center gap-1.5 text-[10px] uppercase tracking-widest text-gray-700">
            <span class="hover:text-gray-500 transition-colors cursor-default">Astro</span>
            <span class="text-gray-800">&middot;</span>
            <span class="hover:text-gray-500 transition-colors cursor-default">Tailwind</span>
            <span class="text-gray-800">&middot;</span>
            <span class="hover:text-gray-500 transition-colors cursor-default">Alpine</span>
        </div>
    </div>
</footer>
