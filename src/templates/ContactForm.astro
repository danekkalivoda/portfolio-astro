---
import ASparkleButton from '../components/atoms/a_sparkle_button.astro'
import MSectionHeading from '../components/molecules/m_section_heading.astro';
---

<div class="relative z-20 floating-section" style="--section-bg: rgb(17 24 39);">
    <div
        class="relative min-h-screen px-4 pt-16 transform-gpu sm:px-16 sm:pt-28 xl:pt-32 floating-section__inner"
        id="kontakt"
        x-data={'{shown : false }'}
        data-header-section="default"
    >
        <div class="w-full xl:flex xl:items-start sm:mx-auto sm:max-w-3xl lg:max-w-4xl xl:max-w-6xl 2xl:max-w-7xl">
            <MSectionHeading
                title="Kontakt"
                description="LEAVE YOUR MESSAGE. I would love to hear about your project. Let's work together."
                theme="dark"
            >
                <div
                    class="transition-transform duration-500 ease-in-out delay-300 transform space-y-4 xl:pl-5 mt-8"
                    x-bind:class={"[shown ? 'translate-y-0' : 'translate-y-full']"}
                >
                    <div>
                        <div class="text-xs uppercase text-gray-400 mb-1">ADDRESS</div>
                        <div class="text-white">Pardubice, Česká republika</div>
                    </div>
                    <div>
                        <div class="text-xs text-gray-400 mb-1">EMAIL</div>
                        <a
                            href="mailto:danek.kalivoda@gmail.com"
                            class="text-lg text-white hover:text-blue-400 transition-colors"
                        >
                            danek.kalivoda@gmail.com
                        </a>
                    </div>
                </div>
            </MSectionHeading>
            <div
                class="w-full xl:w-2/3 xl:pl-24 mt-8 xl:mt-0"
            >
                <form
                    action="https://submit-form.com/dpPht14BY"
                    method="POST"
                    class="space-y-12"
                    x-data="{ submitting: false }"
                    x-on:submit="submitting = true"
                >
                    <div class="floating-label-group">
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            placeholder=" "
                            class="floating-label-input"
                        />
                        <label for="name" class="floating-label">
                            NAME <span class="text-red-500">*</span>
                        </label>
                    </div>
                    <div class="floating-label-group">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder=" "
                            class="floating-label-input"
                        />
                        <label for="email" class="floating-label">
                            EMAIL <span class="text-red-500">*</span>
                        </label>
                    </div>
                    <div class="floating-label-group">
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder=" "
                            class="floating-label-input"
                        />
                        <label for="phone" class="floating-label">
                            PHONE
                        </label>
                    </div>
                    <div
                        class="floating-label-group floating-label-group--select"
                        x-data="{ hasValue: false }"
                        x-bind:class="{ 'has-value': hasValue }"
                    >
                        <select
                            id="service"
                            name="service"
                            required
                            class="floating-label-input floating-label-select"
                            x-on:change="hasValue = $event.target.value !== ''"
                        >
                            <option value="" selected>Vyberte službu</option>
                            <option value="web-design">Web Design</option>
                            <option value="ui-ux-design">UI/UX Design</option>
                            <option value="frontend-development">Frontend Development</option>
                            <option value="mobile-app">Mobilní aplikace</option>
                            <option value="consulting">Konzultace</option>
                            <option value="other">Jiné</option>
                        </select>
                        <label for="service" class="floating-label">
                            SERVICE INTERESTED IN <span class="text-red-500">*</span>
                        </label>
                        <div class="absolute right-0 top-1/2 transform -translate-y-1/2 pointer-events-none">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="floating-label-group floating-label-group--textarea">
                        <textarea
                            id="requirements"
                            name="requirements"
                            required
                            rows="6"
                            placeholder=" "
                            class="floating-label-input floating-label-textarea"
                        ></textarea>
                        <label for="requirements" class="floating-label">
                            DESCRIBE YOUR REQUIREMENTS <span class="text-red-500">*</span>
                        </label>
                    </div>
                    <div>
                        <ASparkleButton
                            type="submit"
                            text="SUBMIT NOW"
                            variant="dark"
                            disabled={true}
                            xBindDisabled="submitting"
                            xText="submitting ? 'Odesílám...' : 'SUBMIT NOW'"
                        />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
