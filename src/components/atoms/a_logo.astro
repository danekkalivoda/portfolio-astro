---
import type { Locale } from "../../i18n/types";
import { getLocalizedPath } from "../../i18n/utils";

export interface Props {
  homepage: boolean;
  locale?: Locale;
}

const { homepage, locale = "cs" } = Astro.props;
const homePath = getLocalizedPath("/", locale);
const logoHref = homepage ? `${homePath}#top` : homePath;
---
<a
    href={logoHref}
    class="header-logo flex shrink-0 items-center justify-center w-auto"
>
    <!-- Avatar - slides in when scrolled past hero -->
    <div class="
        shrink-0 size-6 sm:size-10 overflow-hidden rounded-md
        transition-all duration-150 ease-out
        opacity-0 scale-75
        mr-3
        group-data-show-avatar:opacity-100
        group-data-show-avatar:scale-100
        group-data-show-avatar:translate-x-0
    ">
        <img
            src="/Daniel_Kalivoda.webp"
            width="140"
            height="140"
            alt="Daniel Kalivoda"
            class="object-cover size-6 sm:size-10 rounded-md"
        >
    </div>
    <!-- Title - shifts when avatar appears -->
    <h1 class="
        shrink-0 mr-4 font-semibold text-sm md:text-base lg:text-lg tracking-tighter uppercase
        transition-transform duration-300 ease-out
        -translate-x-9 sm:-translate-x-12
        group-data-show-avatar:translate-x-0
    ">
        Daniel Kalivoda
    </h1>
</a>
