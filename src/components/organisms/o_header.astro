---
import MMenu from "../molecules/m_menu.astro";
import ALogo from "../atoms/a_logo.astro";
const { homepage } = Astro.props;
---
<div class="header-container group" data-header-clip>
    <header
        class="header-base header--dark fixed top-0 left-0 z-100 flex flex-row items-center w-full h-16 pl-4 sm:px-8 sm:h-22 sm:pt-0 backdrop-blur bg-gray-900/75"
        data-header-variant="dark"
    >
        <ALogo homepage={homepage}/>
        <MMenu />
    </header>
</div>
