---
import BaseLayout from '../layouts/BaseLayout.astro'
import ASparkleButton from '../components/atoms/a_sparkle_button.astro'
---
<BaseLayout
    title="Zpráva odeslána - Daniel Kalivoda"
    description="Vaše zpráva byla úspěšně odeslána. Děkuji za váš zájem a brzy se vám ozvu."
>
    <div class="relative z-20 floating-section" style="--section-bg: rgb(17 24 39);">
        <div
            class="relative min-h-screen px-4 pt-16 sm:px-16 sm:pt-28 xl:pt-32 floating-section__inner flex items-center justify-center"
        >
            <div class="w-full sm:mx-auto sm:max-w-xl text-center">
                <div class="mb-8">
                    <svg class="w-20 h-20 mx-auto text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">
                    Zpráva odeslána
                </h1>
                <p class="text-lg text-gray-400 mb-8">
                    Děkuji za váš zájem. Vaše zpráva byla úspěšně odeslána a brzy se vám ozvu.
                </p>
                <ASparkleButton
                    href="/"
                    text="Zpět na úvodní stránku"
                    variant="dark"
                />
            </div>
        </div>
    </div>
</BaseLayout>
