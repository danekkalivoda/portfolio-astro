---
import MTestimonial from '../components/molecules/m_testimonial.astro'
import MSectionHeading from '../components/molecules/m_section_heading.astro';
import type { ITranslations, Locale } from '../i18n/types';

interface Props {
    translations: ITranslations;
    locale: Locale;
}

const { translations } = Astro.props;
const testimonials = translations.testimonials;
const heading = translations.sectionHeadings.clients;
---

<div class="relative z-20 floating-section" style="--section-bg: white;">
    <div
        class="relative min-h-screen px-4 py-16 bg-white transform-gpu sm:px-16 sm:py-28 xl:py-32 floating-section__inner"
        id="klienti"
        x-data={'{shown : false }'}
        data-header-section="white"
    >
        <div class="w-full xl:flex xl:items-start sm:mx-auto sm:max-w-3xl lg:max-w-4xl xl:max-w-6xl 2xl:max-w-7xl">
            <MSectionHeading
                title={heading.title}
                subtitle={heading.subtitle}
                description={heading.description}
                theme="light"
                showButton={true}
                buttonText={heading.buttonText}
            />
            <section
                class="flex flex-col gap-y-4 overflow-hidden xl:w-2/3 -mx-4 xl:pl-24 xl:mx-0"
            >
                {testimonials.map((testimonial, index) => (
                    <MTestimonial
                        name={testimonial.name}
                        role={testimonial.role}
                        company={testimonial.company}
                        quote={testimonial.quote}
                        index={index}
                    />
                ))}
            </section>
        </div>
    </div>
</div>
