---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import HomepageProjects from '../templates/HomepageProjects.astro'
import HomepageServices from '../templates/HomepageServices.astro'
import HomepageClients from '../templates/HomepageClients.astro'
import ContactForm from '../templates/ContactForm.astro'
---
<BaseLayout
    title="Daniel Kalivoda - Product designer, UI developer"
    description="Mám rád funkční věci, které vycházejí z vysokých nároků klienta. Navrhuji weby, mobilní aplikace a UI/UX interních informačních systémů."
    homepage={true}
>
    <Hero slot="beforeContent" />
    <HomepageProjects />
    <HomepageServices />
    <HomepageClients />
    <ContactForm />
</BaseLayout>
