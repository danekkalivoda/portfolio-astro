---
export interface IProps {
  link: string;
}
const props = Astro.props;
---
<a
    href={props.link}
    class="header-menu-link menu-link flex shrink-0 items-center justify-center px-2 last:pr-4 text-sm whitespace-nowrap sm:p-4 lg:text-base xl:px-8"
>
    <span class="menu-link__clip"><span class="menu-link__text"><slot /></span></span>
</a>
