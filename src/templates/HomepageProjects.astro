---
import MProjectSlider from '../components/molecules/m_project_slider.astro'
import MSectionHeading from '../components/molecules/m_section_heading.astro';

interface IProject {
    title: string;
    description: string;
    images: string[];
    categories: string[];
}

const projects: IProject[] = [
    {
        title: 'Recruitis.io',
        description: 'Moderní ATS systém pro efektivní řízení náborových procesů. Centralizovaná správa kandidátů, plánování pohovorů s integrací kalendářů a měření kandidátské zkušenosti. GDPR compliant s kompletní mobilní aplikací.',
        images: ['/recruitis-1.webp', '/recruitis-2.webp', '/recruitis-3.webp'],
        categories: ['SaaS', 'Design System', 'Vue.js']
    },
    {
        title: 'Lékárna.cz',
        description: 'První internetová lékárna v ČR. E-commerce platforma s více než 30 000 produkty a online farmaceutickou podporou. Komplexní poradenský servis dostupný 7 dní v týdnu přes web, mobilní aplikaci i telefon.',
        images: ['/lekarna-1.webp', '/lekarna-2.webp', '/lekarna-3.webp'],
        categories: ['E-commerce', 'UX Design', 'Mobile App']
    },
    {
        title: 'Floweye',
        description: 'Platforma pro řízení podnikových procesů a workflow management. Customizace agend od správy úkolů po řízení dovolených. Cloud-based řešení s okamžitým nasazením a přístupem odkudkoliv.',
        images: ['/floweye-1.webp', '/floweye-2.webp', '/floweye-3.webp'],
        categories: ['SaaS', 'Low-code', 'Dashboard']
    }
];
---

<div class="relative z-20 floating-section" style="--section-bg: white;">
    <div
        class="relative min-h-screen px-4 pt-16 bg-white transform-gpu sm:px-16 sm:pt-28 xl:pt-32 floating-section__inner"
        id="projekty"
        x-data="{shown: false}"
        data-header-section="white"
    >
        <div class="w-full xl:flex xl:items-start sm:mx-auto sm:max-w-3xl lg:max-w-4xl xl:max-w-6xl 2xl:max-w-7xl">
            <MSectionHeading
                title="Projekty"
                description="Dlouhodobé spolupráce, kde jsem mohl dělat produktový design, iterativně a systematicky vytvářet design systémy a vylepšovat produkty."
                theme="light"
                showButton={true}
                buttonText="Napište mi"
                buttonHref="#kontakt"
            />
            <section
                class="flex flex-col pb-4 overflow-hidden xl:w-2/3 xl:mx-0 xl:pl-24"
            >
                {projects.map((project, index) => (
                    <MProjectSlider project={project} index={index} />
                ))}
            </section>
        </div>
    </div>
</div>
