---
import OHeader from '../components/organisms/o_header.astro'
import globalStylesUrl from '../assets/css/global.css?url'

const {title, description, homepage} = Astro.props;
---
<html lang="cs">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{title}</title>
    <meta name="description" content={description}>

    <link rel="stylesheet" type="text/css" href={globalStylesUrl}>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <script>
      import '../assets/js/global.js'
    </script>
  </head>








  <body x-data={"header()"} class="subpixel-antialiased">
    <OHeader homepage={homepage} />
    <slot name="beforeContent"/>
    <slot />
    <slot name="afterContent"/>
  </body>
</html>
