---
export interface Props {
  name: string;
  role?: string;
  company: string;
  quote: string;
  index: number;
}

const { name, role, company, quote, index } = Astro.props;
---

<article
    class="transform-gpu ease-in-out duration-300 ring-1 ring-black/5 m-px mx-4 rounded-md py-7 px-9 xl:mx-px"
    x-data={`{ testimonial${index}Shown: false }`}
    x-intersect:enter.margin.-50px={`testimonial${index}Shown = true`}
    x-intersect:leave.margin.-10px={`testimonial${index}Shown = false`}
    x-bind:class={`[testimonial${index}Shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-16']`}
>
    <div
      class=""
    >
        <blockquote class="mb-7 text-gray-700 leading-relaxed text-sm sm:text-base lg:text-lg">
            "{quote}"
        </blockquote>
        <div class="pt-4 bg-gray-50 rounded-b-md -mx-9 py-4 px-9 -mb-7">
            <div class="font-semibold text-gray-900 text-xs sm:text-base">{name}</div>
            {role && (
                <div class="text-xs sm:text-sm text-gray-500">{role}</div>
            )}
            <div class="text-xs sm:text-sm text-gray-600 font-medium">{company}</div>
        </div>
    </div>
</article>
