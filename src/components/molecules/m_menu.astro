---
import AMenuLink from "../atoms/a_menulink.astro";
import type { INavigation, Locale } from "../../i18n/types";
import { getSectionIds } from "../../i18n/utils";

interface Props {
    navigation: INavigation;
    locale: Locale;
}

const { navigation, locale } = Astro.props;
const sectionIds = getSectionIds(locale);
const sectionLinks = {
    projects: `#${sectionIds.projects}`,
    services: `#${sectionIds.services}`,
    clients: `#${sectionIds.clients}`,
    contact: `#${sectionIds.contact}`,
};
---

<nav
    class="header-nav-scroll flex items-center min-w-0 ml-auto lg:mx-auto text-gray-600 flex-nowrap sm:-mr-4 sm:mt-0 3xl:mr-0
    -translate-x-8 xs:translate-x-0
    transition-transform duration-150 ease-out
    group-data-show-avatar:translate-x-0"
>
    <AMenuLink link={sectionLinks.projects}>{navigation.projects}</AMenuLink>
    <AMenuLink link={sectionLinks.services}>{navigation.services}</AMenuLink>
    <AMenuLink link={sectionLinks.clients}>{navigation.clients}</AMenuLink>
    <AMenuLink link={sectionLinks.contact}>{navigation.contact}</AMenuLink>
</nav>
