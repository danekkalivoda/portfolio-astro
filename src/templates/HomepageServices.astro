---
import MSkill from '../components/molecules/m_skill.astro'
import MSectionHeading from '../components/molecules/m_section_heading.astro';
import type { ITranslations, Locale } from '../i18n/types';
import { formatYears } from '../i18n/utils';

interface Props {
    translations: ITranslations;
    locale: Locale;
}

const { translations, locale } = Astro.props;
const skills = translations.skills;
const heading = translations.sectionHeadings.services;
---

<div class="relative z-10 w-full floating-section" style="--section-bg: rgb(17 24 39);">
    <div
        class="relative px-4 py-16 bg-gray-900 sm:px-16 sm:py-28 xl:py-32 floating-section__inner"
        id="sluzby"
        x-data={'{shown : false }'}
        data-header-section="default"
    >
        <div class="w-full xl:flex xl:items-start sm:mx-auto sm:max-w-3xl lg:max-w-4xl xl:max-w-6xl 2xl:max-w-7xl">
            <MSectionHeading
                title={heading.title}
                subtitle={heading.subtitle}
                description={heading.description}
                theme="dark"
                bottomPadding="large"
                showButton={true}
                buttonText={heading.buttonText}
                buttonHref="#kontakt"
            />
            <div
                class="w-full xl:w-2/3 xl:pl-24 mt-8 xl:mt-0"
            >
                <div
                    x-data="{ skillsShown: false }"
                    x-intersect:enter.margin.-30px="skillsShown = true"
                    x-intersect:leave.margin.-30px="skillsShown = false"
                >
                    {skills.map((skill, index) => (
                        <MSkill
                            name={skill.name}
                            category={skill.category}
                            years={formatYears(skill.years, locale)}
                            icon={skill.icon}
                            iconColor={skill.iconColor}
                            index={index}
                        />
                    ))}
                </div>
            </div>
        </div>
    </div>
</div>
