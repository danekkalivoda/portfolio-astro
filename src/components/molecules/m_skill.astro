---
export interface IProps {
  name: string;
  category: string;
  years: string;
  icon?: string;
  iconColor?: string;
  index: number;
}

const props = Astro.props;
---

<div
    class="transform-gpu ease-in-out duration-300 border-t border-gray-800 last:border-b py-4 -mx-4 lg:mx-0"
    x-bind:class="skillsShown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'"
    style={`transition-delay: ${props.index * 80}ms;`}
>
    <div
        class=""
    >
        <div class="flex items-center">
            {props.icon ? (
                <div
                    class="size-6 ml-4 mr-3 sm:ml-0 sm:size-10 xl:size-16 flex items-center justify-center shrink-0 self-center bg-gray-800 rounded p-1 sm:p-2 lg:p-3"
                    style={props.iconColor ? `color: ${props.iconColor}` : undefined}
                >
                    <Fragment set:html={props.icon} class="size-full" />
                </div>
            ) : (
                <div class="size-6 mx-4 sm:ml-0 sm:size-10 xl:size-16 flex items-center justify-center shrink-0 self-center bg-gray-800 rounded p-1 sm:p-2 lg:p-3">
                    <span class="text-gray-400 text-xs font-bold">{props.name.charAt(0)}</span>
                </div>
            )}
            <div class="flex-1 min-w-0">
                <h3 class="text-white font-semibold text-base sm:text-lg mb-1">{props.name}</h3>
                <p class="text-gray-400 text-xs tracking-wider">{props.category}</p>
            </div>
            <span class="text-gray-500 text-sm font-medium mx-4 shrink-0 sm:mr-0">{props.years}</span>
        </div>
    </div>
</div>
