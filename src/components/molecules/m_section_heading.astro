---
import ASparkleButton from '../atoms/a_sparkle_button.astro';

interface IProps {
    title: string;
    description: string;
    theme?: 'light' | 'dark';
    bottomPadding?: 'default' | 'large';
    showButton?: boolean;
    buttonText?: string;
    buttonHref?: string;
}

const props = Astro.props as IProps;

const theme = props.theme || 'light';
const bottomPadding = props.bottomPadding || 'default';
const showButton = props.showButton || false;

const titleColor = theme === 'light' ? 'text-gray-900' : 'text-white';
const descColor = theme === 'light' ? 'text-gray-500' : 'text-gray-400';
const pbClass = bottomPadding === 'large' ? 'xl:pb-32' : 'xl:pb-24';
---

<div class:list={["w-full transition-opacity duration-500 ease-in-out delay-300 xl:w-1/3 xl:sticky xl:top-32", pbClass]} x-bind:class="[shown ? 'opacity-100' : 'opacity-0']">
    <h2 class:list={["relative block mb-4 overflow-hidden text-2xl font-bold uppercase transform sm:text-3xl lg:text-5xl xl:text-6xl sm:mb-8 pl-9 pr-4 xl:pr-0 xl:pl-5", titleColor]}>
        <span class="relative z-10 block transition-transform duration-500 ease-in-out delay-300 sm:px-8 sm:-mx-8 2xl:px-16 2xl:-mx-16" x-bind:class="[shown ? 'translate-y-0' : 'translate-y-full']">
            {props.title}
        </span>
    </h2>
    <div class:list={["mb-8 overflow-hidden text-base sm:text-lg lg:text-xl", descColor]}>
        <p class:list={["leading-relaxed transition-transform duration-500 ease-in-out delay-300 transform pl-9 pr-4 xl:pr-0 xl:pl-5", { "mb-4 sm:mb-8": showButton }]} x-bind:class="[shown ? 'translate-y-0' : 'translate-y-full']" x-intersect:enter="shown = true">
            {props.description}
        </p>
        {showButton && props.buttonText && (
            <div class="transition-transform duration-500 ease-in-out delay-500 transform pl-4 xl:pl-0" x-bind:class="[shown ? 'translate-y-0' : 'translate-y-full']">
                <ASparkleButton
                    href={props.buttonHref}
                    text={props.buttonText}
                    variant={theme}
                />
            </div>
        )}
        <slot />
    </div>
</div>
