---
import MProjectSlider from '../components/molecules/m_project_slider.astro'
import MSectionHeading from '../components/molecules/m_section_heading.astro';
import type { ITranslations, Locale } from '../i18n/types';

interface Props {
    translations: ITranslations;
    locale: Locale;
}

const { translations } = Astro.props;
const projects = translations.projects;
const heading = translations.sectionHeadings.projects;
---

<div class="relative z-20 floating-section" style="--section-bg: white;">
    <div
        class="relative min-h-screen px-4 pt-16 bg-white transform-gpu sm:px-16 sm:pt-28 xl:pt-32 floating-section__inner"
        id="projekty"
        x-data="{shown: false}"
        data-header-section="white"
    >
        <div class="w-full xl:flex xl:items-start sm:mx-auto sm:max-w-3xl lg:max-w-4xl xl:max-w-6xl 2xl:max-w-7xl">
            <MSectionHeading
                title={heading.title}
                subtitle={heading.subtitle}
                description={heading.description}
                theme="light"
                showButton={true}
                buttonText={heading.buttonText}
                buttonHref="#kontakt"
            />
            <section
                class="flex flex-col pb-4 overflow-hidden xl:w-2/3 xl:mx-0 xl:pl-24"
            >
                {projects.map((project, index) => (
                    <MProjectSlider project={project} index={index} />
                ))}
            </section>
        </div>
    </div>
</div>
